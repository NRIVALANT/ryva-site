# Secret : jamais préfixé NEXT_PUBLIC_, jamais commité avec une valeur
RESEND_API_KEY=

# Adresse qui reçoit les demandes de démo
CONTACT_TO_EMAIL=

# Expéditeur, sur un domaine vérifié chez Resend
CONTACT_FROM_EMAIL=

# URL publique du site, sans slash final
NEXT_PUBLIC_SITE_URL=

# "true" uniquement en production, le jour de la mise en ligne
SITE_INDEXABLE=
